[Unit]
Description=Atrium edge proxy (Caddy, automatic + on-demand TLS)
Requires=atrium-api.service atrium-admin.service atrium-renderer.service atrium-s3.service
After=atrium-api.service atrium-admin.service atrium-renderer.service

[Container]
ContainerName=atrium-caddy
Image=docker.io/library/caddy:2.11.6-alpine@sha256:d44355d3c2149dc580ce2cac735955d1c08d3d00882c30489c241aa51a5c10d9
Network=atrium.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
# Hosts + ACME email only: ~/.config/atrium/caddy.env
EnvironmentFile=%h/.config/atrium/caddy.env
Volume=%h/.config/atrium/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=atrium-caddy-data.volume:/data
Volume=atrium-caddy-config.volume:/config
DropCapability=all
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
