[Unit]
Description=Atrium database migrations (one-shot)
Requires=atrium-postgres.service
After=atrium-postgres.service

[Container]
ContainerName=atrium-migrate
Image=ghcr.io/your-org/atrium-migrate:latest
Network=atrium-data.network
EnvironmentFile=%h/.config/atrium/atrium.env
# migrate.env overrides DATABASE_URL with the owner role (MIGRATE_DATABASE_URL); the app role is DML-only.
EnvironmentFile=%h/.config/atrium/migrate.env
Environment=CHECKPOINT_DISABLE=1
DropCapability=all
NoNewPrivileges=true

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=600
