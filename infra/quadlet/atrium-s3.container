[Unit]
Description=Atrium object storage (SeaweedFS S3)

[Container]
ContainerName=atrium-s3
Image=docker.io/chrislusf/seaweedfs:4.48@sha256:4e61d15fd35994cb1e43e1e553dff106794841fd9a99ade2fc8c8bfce4d7872d
# master/volume/filer (+gRPC) bind to 127.0.0.1 inside the container; only the S3 gateway (:8333) is
# reachable on the networks (edge: Caddy serves the media bucket; data: api/worker).
Exec=server -dir=/data -ip=127.0.0.1 -ip.bind=127.0.0.1 -master.volumeSizeLimitMB=1024 -volume.max=0 -s3 -s3.ip.bind=0.0.0.0 -s3.port=8333 -s3.config=/etc/seaweedfs/s3.json
Network=atrium.network
Network=atrium-data.network
NetworkAlias=s3
Volume=atrium-s3.volume:/data
Volume=%h/.config/atrium/seaweedfs/s3.json:/etc/seaweedfs/s3.json:ro,Z
HealthCmd=wget -q -O /dev/null http://127.0.0.1:9333/cluster/status
HealthInterval=10s
HealthRetries=30
Notify=healthy
NoNewPrivileges=true

[Service]
Restart=always
# create the bucket once the server is healthy (idempotent)
ExecStartPost=/bin/sh -c 'sleep 3; echo "s3.bucket.create -name atrium-media" | podman exec -i atrium-s3 weed shell -master=127.0.0.1:9333 || true'

[Install]
WantedBy=default.target
