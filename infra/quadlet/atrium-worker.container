[Unit]
Description=Atrium worker (BullMQ)
Requires=atrium-migrate.service atrium-redis.service atrium-postgres.service
After=atrium-migrate.service atrium-redis.service atrium-postgres.service

[Container]
ContainerName=atrium-worker
Image=ghcr.io/your-org/atrium-worker:latest
AutoUpdate=registry
Network=atrium.network
Network=atrium-data.network
NetworkAlias=worker
EnvironmentFile=%h/.config/atrium/atrium.env
Environment=MALLOC_ARENA_MAX=2 npm_config_cache=/tmp/.npm XDG_CACHE_HOME=/tmp/.cache LOCAL_STORAGE_DIR=/app/apps/api/storage
# STORAGE_DRIVER=local: same storage volume as the API (media processing reads originals, writes variants).
Volume=atrium-api-storage.volume:/app/apps/api/storage
# Opt-in local builds (WORKER_ENABLE_LOCAL_BUILDS=1) run npm in /tmp: larger, exec allowed.
Tmpfs=/tmp:rw,size=2g,mode=1777,exec
# Immutable root filesystem (tmpfs /tmp, /var/tmp, /run), no capabilities, no privilege escalation.
ReadOnly=true
ReadOnlyTmpfs=true
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=45

[Install]
WantedBy=default.target
