[Unit]
Description=Atrium admin + builder
Requires=atrium-api.service
After=atrium-api.service

[Container]
ContainerName=atrium-admin
Image=ghcr.io/your-org/atrium-admin:latest
AutoUpdate=registry
Network=atrium.network
NetworkAlias=admin
# Public URLs only (no secrets): ~/.config/atrium/admin.env
EnvironmentFile=%h/.config/atrium/admin.env
Environment=ATRIUM_API_INTERNAL_URL=http://api:4000
Volume=atrium-admin-cache.volume:/app/apps/admin/.next/cache
# Immutable root filesystem (tmpfs /tmp, /var/tmp, /run), no capabilities, no privilege escalation.
ReadOnly=true
ReadOnlyTmpfs=true
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=45

[Install]
WantedBy=default.target
