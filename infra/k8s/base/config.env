NODE_ENV=production
ADMIN_URL=https://admin.example.com
API_URL=https://api.example.com
RENDERER_URL=https://sites.example.com
PLATFORM_SITES_DOMAIN=sites.example.com
PREVIEW_URL=https://sites.example.com
ATRIUM_API_INTERNAL_URL=http://atrium-api:4000
CORS_ORIGINS=https://admin.example.com
COOKIE_DOMAIN=admin.example.com
COOKIE_SECURE=true
TRUST_PROXY=true
PLATFORM_CNAME_TARGET=sites.example.com
API_PORT=4000
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_PUBLIC_URL=https://media.example.com
S3_REGION=us-east-1
S3_BUCKET=atrium-media
S3_FORCE_PATH_STYLE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
MAIL_FROM=Atrium <no-reply@example.com>
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
SEED_ADMIN_EMAIL=admin@example.com
DATABASE_POOL_SIZE=10
# Backups (CronJob): bucket + optional endpoint for S3-compatible providers
BACKUP_BUCKET=atrium-backups
BACKUP_S3_ENDPOINT=
