# Placeholder values so the base renders. NEVER deploy these — overlays replace the Secret
# from a git-ignored secrets.env (`atrium setup production --target k8s` generates one),
# or swap this generator for External Secrets / Sealed Secrets / CSI secrets store.
DATABASE_URL=postgresql://atrium:REPLACE_ME@db.example.internal:5432/atrium?sslmode=require
