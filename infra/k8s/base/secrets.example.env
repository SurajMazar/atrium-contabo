JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME
RENDERER_SECRET=REPLACE_ME
ANALYTICS_SALT=REPLACE_ME
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
SMTP_USER=
SMTP_PASSWORD=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
