{
  "name": "@atrium/animations",
  "version": "0.1.0",
  "private": true,
  "description": "GSAP animation preset registry and framework-agnostic runtime",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@atrium/schema": "workspace:*"
  },
  "devDependencies": {
    "@atrium/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.3",
    "gsap": "^3.15.0"
  },
  "peerDependencies": {
    "gsap": "^3.13.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    }
  }
}