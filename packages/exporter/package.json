{
  "name": "@atrium/exporter",
  "version": "0.1.0",
  "private": true,
  "description": "Builds deployable packages from a site snapshot: standalone Next.js project, static export manifest, site schema bundles (export/import/clone)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atrium/schema": "workspace:*",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@atrium/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.3",
    "@types/node": "^24.0.0"
  }
}
