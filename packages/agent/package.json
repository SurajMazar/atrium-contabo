{
  "name": "@atrium/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral AI site agent: planner prompts, builder tools, generation pipeline. AI operates the builder through the same SiteOperations humans use.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atrium/schema": "workspace:*",
    "@atrium/component-registry": "workspace:*",
    "@atrium/builder-core": "workspace:*",
    "@atrium/design-tokens": "workspace:*",
    "@atrium/animations": "workspace:*",
    "@atrium/providers": "workspace:*",
    "immer": "^10.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@atrium/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.3",
    "@types/node": "^24.0.0"
  }
}
