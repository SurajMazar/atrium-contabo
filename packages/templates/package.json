{
  "name": "@atrium/templates",
  "version": "0.1.0",
  "private": true,
  "description": "Site blueprints, demo websites, page and section templates (pure data validated against the registry)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atrium/schema": "workspace:*",
    "@atrium/component-registry": "workspace:*",
    "@atrium/design-tokens": "workspace:*",
    "@atrium/builder-core": "workspace:*"
  },
  "devDependencies": {
    "@atrium/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
