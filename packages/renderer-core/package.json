{
  "name": "@atrium/renderer-core",
  "version": "0.1.0",
  "private": true,
  "description": "React renderers for every registered component + page/site rendering engine (server-first, islands for interactivity)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./styles.css": "./src/styles/renderer.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atrium/schema": "workspace:*",
    "@atrium/component-registry": "workspace:*",
    "@atrium/design-tokens": "workspace:*",
    "@atrium/animations": "workspace:*",
    "@atrium/builder-core": "workspace:*",
    "gsap": "^3.15.0",
    "lucide-react": "^1.52.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@atrium/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^27.0.0"
  }
}
