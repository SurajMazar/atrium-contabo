# Generated by `atrium setup production --target k8s` ({{generatedAt}}).
# Overlay on the repository base at {{k8sBase}}.
#   kubectl kustomize . | kubectl apply -f -
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: {{namespace}}
resources:
  - {{k8sBase}}
# Non-HA in-cluster PostgreSQL/Redis for staging — uncomment and point DATABASE_URL/REDIS_URL at
# atrium-postgres / atrium-redis in secrets.env:
# components:
#   - {{k8sComponents}}/in-cluster-data
images:
  - { name: ghcr.io/your-org/atrium-api, newName: {{registry}}/atrium-api, newTag: "{{tag}}" }
  - { name: ghcr.io/your-org/atrium-worker, newName: {{registry}}/atrium-worker, newTag: "{{tag}}" }
  - { name: ghcr.io/your-org/atrium-renderer, newName: {{registry}}/atrium-renderer, newTag: "{{tag}}" }
  - { name: ghcr.io/your-org/atrium-admin, newName: {{registry}}/atrium-admin, newTag: "{{tag}}" }
  - { name: ghcr.io/your-org/atrium-migrate, newName: {{registry}}/atrium-migrate, newTag: "{{tag}}" }
configMapGenerator:
  - name: atrium-config
    behavior: replace
    envs: [config.env]
secretGenerator:
  - name: atrium-secrets
    behavior: replace
    envs: [secrets.env]
patches:
  - path: ingress-patch.yaml
