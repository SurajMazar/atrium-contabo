# ─── Atrium environment ─────────────────────────────────────────────
# Copy to .env (or run `pnpm atrium init`, which generates secrets for you).
NODE_ENV=development

# Public URLs
ADMIN_URL=http://localhost:3000
API_URL=http://localhost:4000
RENDERER_URL=http://localhost:3001
# Sites are served at {slug}.{PLATFORM_SITES_DOMAIN}; *.localhost resolves to 127.0.0.1 in browsers.
PLATFORM_SITES_DOMAIN=sites.localhost:3001
PREVIEW_URL=http://localhost:3001

# Ports
API_PORT=4000
ADMIN_PORT=3000
RENDERER_PORT=3001

# Database (podman compose maps postgres to 55432 to avoid clashing with other stacks)
ATRIUM_PG_PORT=55432
POSTGRES_USER=atrium
POSTGRES_PASSWORD=atrium
POSTGRES_DB=atrium
DATABASE_URL=postgresql://atrium:atrium@localhost:55432/atrium

# Redis / BullMQ
ATRIUM_REDIS_PORT=56379
REDIS_URL=redis://localhost:56379

# Security — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
# 32-byte key, base64 (openssl rand -base64 32). Encrypts provider credentials at rest.
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Shared secret between API and renderer for revalidation + preview.
RENDERER_SECRET=change-me-renderer-secret
# Salt for privacy-preserving analytics hashes.
ANALYTICS_SALT=change-me-analytics-salt
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Default platform storage (SeaweedFS S3 locally; any S3-compatible endpoint in production)
STORAGE_DRIVER=s3
ATRIUM_S3_PORT=59000
S3_ENDPOINT=http://localhost:59000
S3_PUBLIC_URL=http://localhost:59000/atrium-media
S3_REGION=us-east-1
S3_BUCKET=atrium-media
S3_ACCESS_KEY_ID=atrium
S3_SECRET_ACCESS_KEY=atrium-secret
S3_FORCE_PATH_STYLE=true
# For STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4000/v1/storage

# Default platform email (Mailpit locally: UI at http://localhost:58025)
ATRIUM_SMTP_PORT=51025
ATRIUM_MAILPIT_PORT=58025
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Atrium <no-reply@atrium.localhost>

# AI (optional platform-level keys; organizations can bring their own in Integrations)
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
GEMINI_API_KEY=

# Deployments (optional platform-level Vercel token; orgs can connect their own)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Seed
SEED_ADMIN_EMAIL=admin@atrium.localhost
SEED_ADMIN_PASSWORD=Atrium!2026
